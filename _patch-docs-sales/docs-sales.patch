+// Independent read-only sales collector. It never loads the BoykovDocs application or writes its data.
+import { DatabaseSync } from "node:sqlite";
+import { createHash, randomUUID } from "node:crypto";
+import {
+  readFileSync,
+  mkdirSync,
+  chmodSync,
+  writeFileSync,
+  renameSync,
+  rmSync,
+} from "node:fs";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import { setTimeout as delay } from "node:timers/promises";
+import { normalizeDocsSale } from "../../shared/docs-sales.js";
+const hash = (s) => createHash("sha256").update(s).digest("hex");
+const text = (s, max) =>
+  typeof s === "string"
+    ? s
+        .replace(/[\u0000-\u001f\u007f\u202a-\u202e\u2066-\u2069]/g, "")
+        .trim()
+        .slice(0, max)
+    : "";
+const date = (s) =>
+  typeof s === "string" && Number.isFinite(Date.parse(s))
+    ? new Date(s).toISOString()
+    : null;
+export function validateSalesConnection(config) {
+  const url = new URL(config.endpoint);
+  if (
+    url.protocol !== "https:" ||
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash ||
+    url.pathname !== "/hooks/docs-customers/sales" ||
+    !/^[a-f0-9]{64}$/.test(config.token || "")
+  )
+    throw Error("INVALID_DOCS_SALES_CONNECTION");
+  return url.href;
+}
+export class DocsSalesAgent {
+  constructor(config, { fetcher = fetch, now = Date.now } = {}) {
+    this.config = { ...config, endpoint: validateSalesConnection(config) };
+    this.fetcher = fetcher;
+    this.now = now;
+    mkdirSync(config.stateDir, { recursive: true, mode: 0o700 });
+    const file = join(config.stateDir, "delivery.sqlite");
+    this.db = new DatabaseSync(file);
+    chmodSync(file, 0o600);
+    this.db
+      .exec(`PRAGMA journal_mode=WAL;PRAGMA synchronous=FULL;PRAGMA busy_timeout=5000;
+  CREATE TABLE IF NOT EXISTS identity(id INTEGER PRIMARY KEY CHECK(id=1),endpoint TEXT NOT NULL,source TEXT NOT NULL);
+  CREATE TABLE IF NOT EXISTS outbox(event_id TEXT PRIMARY KEY,purchase_id TEXT NOT NULL,payload TEXT NOT NULL,queued_at INTEGER NOT NULL,delivered INTEGER NOT NULL DEFAULT 0,attempts INTEGER NOT NULL DEFAULT 0,next_at INTEGER NOT NULL DEFAULT 0,error TEXT NOT NULL DEFAULT '');
+  CREATE INDEX IF NOT EXISTS outbox_due ON outbox(delivered,next_at);
+  CREATE TABLE IF NOT EXISTS capture(purchase_id TEXT PRIMARY KEY,fingerprint TEXT NOT NULL);
+  CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY,value TEXT NOT NULL);`);
+    const identity = this.db.prepare("SELECT * FROM identity WHERE id=1").get();
+    if (
+      identity &&
+      (identity.endpoint !== this.config.endpoint ||
+        identity.source !== resolve(config.sourceDir))
+    ) {
+      this.db.close();
+      throw Error("DOCS_SALES_QUEUE_BELONGS_TO_ANOTHER_SOURCE");
+    }
+    this.db
+      .prepare("INSERT OR IGNORE INTO identity VALUES(1,?,?)")
+      .run(this.config.endpoint, resolve(config.sourceDir));
+    this.scanOk = false;
+    this.errorCode = "";
+    this.sourceCount = Number(this.get("source_count") || 0);
+    this.invalid = 0;
+  }
+  get(key) {
+    return this.db.prepare("SELECT value FROM meta WHERE key=?").get(key)
+      ?.value;
+  }
+  set(key, value) {
+    this.db
+      .prepare(
+        "INSERT INTO meta VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
+      )
+      .run(key, String(value));
+  }
+  capture(event) {
+    const content = { user: event.user, purchase: event.purchase },
+      fingerprint = hash(JSON.stringify(content));
+    if (
+      this.db
+        .prepare("SELECT fingerprint FROM capture WHERE purchase_id=?")
+        .get(event.purchase.id)?.fingerprint === fingerprint
+    )
+      return;
+    this.db.exec("BEGIN IMMEDIATE");
+    try {
+      const observed = Math.max(this.now(), Number(this.get("clock") || 0) + 1),
+        payload = {
+          ...event,
+          eventId: randomUUID(),
+          observedAt: new Date(observed).toISOString(),
+        };
+      this.db
+        .prepare(
+          "INSERT INTO outbox(event_id,purchase_id,payload,queued_at) VALUES(?,?,?,?)",
+        )
+        .run(
+          payload.eventId,
+          payload.purchase.id,
+          JSON.stringify(payload),
+          this.now(),
+        );
+      this.db
+        .prepare(
+          "INSERT INTO capture VALUES(?,?) ON CONFLICT(purchase_id) DO UPDATE SET fingerprint=excluded.fingerprint",
+        )
+        .run(payload.purchase.id, fingerprint);
+      this.set("clock", observed);
+      this.db.exec("COMMIT");
+    } catch (e) {
+      if (this.db.isTransaction) this.db.exec("ROLLBACK");
+      throw e;
+    }
+  }
+  scan() {
+    this.scanOk = false;
+    this.invalid = 0;
+    let users;
+    try {
+      const rows = JSON.parse(
+        readFileSync(join(this.config.sourceDir, "users.json"), "utf8"),
+      );
+      if (!Array.isArray(rows)) throw Error();
+      users = new Map();
+      for (const u of rows) {
+        if (!u || typeof u.id !== "string" || !u.id || users.has(u.id))
+          throw Error();
+        const email = text(u.email, 254);
+        users.set(u.id, {
+          id: u.id,
+          name: text(u.name, 200),
+          phone: text(u.phone, 80),
+          email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? email : "",
+          registeredAt: date(u.createdAt),
+        });
+      }
+    } catch {
+      this.errorCode = "users_read_failed";
+      return;
+    }
+    let wallet;
+    try {
+      try {
+        wallet = JSON.parse(
+          readFileSync(join(this.config.sourceDir, "wallets.json"), "utf8"),
+        );
+      } catch (e) {
+        if (e.code !== "ENOENT") throw e;
+        try {
+          readFileSync(join(this.config.sourceDir, "wallets.json.initialized"));
+          throw Error("MISSING_INITIALIZED_WALLET");
+        } catch (marker) {
+          if (marker.code !== "ENOENT") throw marker;
+        }
+        wallet = { version: 1, purchases: [] };
+      }
+      if (wallet.version !== 1 || !Array.isArray(wallet.purchases))
+        throw Error();
+    } catch {
+      this.errorCode = "wallet_read_failed";
+      return;
+    }
+    const events = [],
+      ids = new Set(),
+      ownership = new Set();
+    try {
+      for (const row of wallet.purchases) {
+        const u = users.get(row?.userId) || {
+          id: row?.userId,
+          name: "",
+          phone: "",
+          email: "",
+          registeredAt: null,
+        };
+        const event = normalizeDocsSale(
+          {
+            protocol: 1,
+            eventId: "validation",
+            observedAt: new Date(this.now()).toISOString(),
+            user: u,
+            purchase: {
+              id: row.id,
+              userId: row.userId,
+              instructionId: row.instructionId,
+              title: text(row.title, 500),
+              format: row.format,
+              amountMinor: row.amountMinor,
+              currency: "RUB",
+              createdAt: row.createdAt,
+            },
+          },
+          this.now(),
+        );
+        const key = JSON.stringify([
+          event.user.id,
+          event.purchase.instructionId,
+          event.purchase.format,
+        ]);
+        if (ids.has(event.purchase.id) || ownership.has(key)) throw Error();
+        ids.add(event.purchase.id);
+        ownership.add(key);
+        events.push(event);
+      }
+    } catch {
+      this.errorCode = "invalid_source_data";
+      this.invalid = 1;
+      return;
+    }
+    for (const event of events) this.capture(event);
+    this.sourceCount = events.length;
+    this.set("source_count", events.length);
+    this.set("source_generated_at", new Date(this.now()).toISOString());
+    const previous = Number(this.get("maximum_source_count") || 0);
+    this.errorCode = events.length < previous ? "source_count_decreased" : "";
+    this.set("maximum_source_count", Math.max(previous, events.length));
+    this.scanOk = true;
+  }
+  status() {
+    const row = this.db
+      .prepare(
+        "SELECT count(*) pending,MIN(queued_at) oldest,COALESCE(SUM(error IN ('HTTP_400','HTTP_401','HTTP_403','HTTP_409','HTTP_413','HTTP_422','INVALID_ACK')),0) rejected FROM outbox WHERE delivered=0",
+      )
+      .get();
+    const stalled =
+      row.oldest &&
+      this.now() - row.oldest > 300000 &&
+      this.now() - Number(this.get("last_delivery_at") || 0) > 180000;
+    return {
+      scanOk: this.scanOk,
+      sourceCount: this.sourceCount,
+      pending: row.pending,
+      rejected: row.rejected + this.invalid,
+      errorCode: this.errorCode || (stalled ? "delivery_delayed" : ""),
+      sourceGeneratedAt:
+        this.get("source_generated_at") || new Date(this.now()).toISOString(),
+    };
+  }
+  request(path, payload) {
+    return this.fetcher(this.config.endpoint + path, {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        Authorization: "Bearer " + this.config.token,
+      },
+      body: JSON.stringify(payload),
+      redirect: "error",
+      signal: AbortSignal.timeout(12000),
+    });
+  }
+  async deliver() {
+    const fresh = this.db
+        .prepare(
+          "SELECT rowid,* FROM outbox WHERE delivered=0 AND next_at<=? ORDER BY rowid DESC LIMIT 10",
+        )
+        .all(this.now()),
+      old = this.db
+        .prepare(
+          "SELECT rowid,* FROM outbox WHERE delivered=0 AND next_at<=? ORDER BY rowid LIMIT 50",
+        )
+        .all(this.now());
+    const rows = [
+        ...new Map([...fresh, ...old].map((r) => [r.event_id, r])).values(),
+      ].slice(0, 50),
+      started = Date.now();
+    for (const row of rows) {
+      if (Date.now() - started > 90000) break;
+      let error = "",
+        stop = false;
+      try {
+        const p = JSON.parse(row.payload),
+          r = await this.request("", p);
+        if (!r.ok) {
+          error = "HTTP_" + r.status;
+          stop = r.status === 401 || r.status === 403;
+        } else {
+          const ack = await r.json();
+          if (
+            ack.ok === true &&
+            ack.eventId === row.event_id &&
+            ack.externalId === p.user.id &&
+            ack.saleId === p.purchase.id
+          ) {
+            this.db
+              .prepare(
+                "UPDATE outbox SET delivered=1,error='' WHERE event_id=?",
+              )
+              .run(row.event_id);
+            this.set("last_delivery_at", this.now());
+            continue;
+          }
+          error = "INVALID_ACK";
+        }
+      } catch {
+        error = "NETWORK_ERROR";
+        stop = true;
+      }
+      this.db
+        .prepare(
+          "UPDATE outbox SET attempts=attempts+1,next_at=?,error=? WHERE event_id=?",
+        )
+        .run(
+          this.now() + Math.min(900000, 5000 * 2 ** Math.min(row.attempts, 8)),
+          error,
+          row.event_id,
+        );
+      if (stop) break;
+    }
+  }
+  async cycle() {
+    this.scan();
+    await this.deliver();
+    const s = this.status(),
+      response = await this.request("/heartbeat", s);
+    if (!response.ok)
+      throw Error("DOCS_SALES_HEARTBEAT_HTTP_" + response.status);
+    const ack = await response.json();
+    if (ack.ok !== true || ack.source !== "boykovdocs-sales")
+      throw Error("INVALID_DOCS_SALES_HEARTBEAT");
+    const file = join(this.config.stateDir, "status.json"),
+      temporary = file + "." + randomUUID();
+    try {
+      writeFileSync(
+        temporary,
+        JSON.stringify({ ...s, checkedAt: new Date(this.now()).toISOString() }),
+        { mode: 0o600, flag: "wx" },
+      );
+      renameSync(temporary, file);
+    } finally {
+      rmSync(temporary, { force: true });
+    }
+    return s;
+  }
+  close() {
+    this.db.close();
+  }
+}
+if (
+  process.argv[1] &&
+  import.meta.url === pathToFileURL(resolve(process.argv[1])).href
+) {
+  process.umask(0o077);
+  let config;
+  try {
+    config = JSON.parse(readFileSync(process.argv[2], "utf8"));
+  } catch {
+    throw Error("DOCS_SALES_CONFIGURATION_UNREADABLE");
+  }
+  const agent = new DocsSalesAgent(config),
+    stop = new AbortController();
+  for (const signal of ["SIGTERM", "SIGINT"])
+    process.once(signal, () => stop.abort());
+  const cycle = async () => {
+    try {
+      const s = await agent.cycle();
+      console.log(
+        "DOCS_SALES_SYNC=" +
+          (s.scanOk && !s.rejected && !s.errorCode ? "OK" : "CHECK_REQUIRED") +
+          " SOURCE_PURCHASES=" +
+          s.sourceCount +
+          " PENDING=" +
+          s.pending +
+          " REJECTED=" +
+          s.rejected,
+      );
+      return s.scanOk && !s.rejected && !s.errorCode;
+    } catch {
+      console.error("DOCS_SALES_SYNC=CONNECTION_CHECK_REQUIRED");
+      return false;
+    }
+  };
+  try {
+    if (process.argv.includes("--once"))
+      process.exitCode = (await cycle()) ? 0 : 1;
+    else
+      while (!stop.signal.aborted) {
+        await cycle();
+        if (!stop.signal.aborted)
+          await delay(30000, undefined, { signal: stop.signal }).catch((e) => {
+            if (e.name !== "AbortError") throw e;
+          });
+      }
+  } finally {
+    agent.close();
+  }
+}
diff --git a/scripts/install-docs-sales.sh b/scripts/install-docs-sales.sh
new file mode 100644
index 0000000..5cb4a72
--- /dev/null
+++ b/scripts/install-docs-sales.sh
@@ -0,0 +1,95 @@
+#!/usr/bin/env bash
+# Run on the BoykovDocs VPS. This installs a separate read-only collector only.
+set -Eeuo pipefail
+umask 077
+cd "$(dirname -- "${BASH_SOURCE[0]}")/.."
+[[ "$EUID" == 0 ]] || { echo DOCS_SALES_REQUIRES_ROOT; exit 1; }
+for command in docker python3; do command -v "$command" >/dev/null || { echo "DOCS_SALES_MISSING=$command"; exit 1; }; done
+docker compose version >/dev/null
+for file in integrations/docs-customers/sales-agent.mjs shared/docs-sales.js shared/docs-customers.js; do [[ -f "$file" ]] || { echo DOCS_SALES_SOURCE_MISSING; exit 1; }; done
+existing_config=/opt/boykovdocs-customers-delivery/config.json
+[[ -f "$existing_config" ]] || { echo DOCS_SALES_CONNECT_CUSTOMERS_FIRST; exit 1; }
+source_dir=$(docker inspect boykovdocs-api --format '{{range .Mounts}}{{if eq .Destination "/app/data"}}{{.Source}}{{end}}{{end}}')
+[[ "$source_dir" == /* && -f "$source_dir/users.json" ]] || { echo DOCS_SALES_SOURCE_DATA_NOT_FOUND; exit 1; }
+source_uid=$(docker exec boykovdocs-api id -u)
+source_gid=$(docker exec boykovdocs-api id -g)
+[[ "$source_uid" =~ ^[0-9]+$ && "$source_gid" =~ ^[0-9]+$ ]] || exit 1
+root=/opt/boykovdocs-sales-delivery
+install -d -m 700 "$root"
+backup=$(mktemp -d "$root/pre-connect-XXXXXXXX")
+for file in config.json compose.json; do if [[ -f "$root/$file" ]]; then cp -p "$root/$file" "$backup/$file"; fi; done
+# Reuse the already installed private key; never echo it or pass it in arguments.
+python3 - "$existing_config" "$backup/candidate-config.json" <<'PY'
+import sys,json,re,urllib.request,urllib.parse,os
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+ def redirect_request(self,*args): return None
+try:
+ with open(sys.argv[1],encoding='utf-8') as file: old=json.load(file)
+ url=urllib.parse.urlsplit(old['endpoint'])
+ if url.scheme!='https' or not url.netloc or url.username or url.password or url.query or url.fragment or url.path!='/hooks/docs-customers': raise ValueError()
+ key=old['token']
+ if not re.fullmatch('[a-f0-9]{64}',key): raise ValueError()
+ endpoint=old['endpoint']+'/sales'
+ request=urllib.request.Request(endpoint+'/handshake',data=b'{}',headers={'Content-Type':'application/json','Authorization':'Bearer '+key},method='POST')
+ with urllib.request.build_opener(NoRedirect).open(request,timeout=20) as response: result=json.load(response)
+ if result.get('ok') is not True or result.get('source')!='boykovdocs-sales' or result.get('protocol')!=1 or result.get('scope')!='all-purchases': raise ValueError()
+ with open(sys.argv[2],'x',encoding='utf-8') as file: json.dump({'endpoint':endpoint,'token':key,'sourceDir':'/source','stateDir':'/state'},file)
+ os.chmod(sys.argv[2],0o600)
+except Exception: raise SystemExit('DOCS_SALES_HUB_CHECK_FAILED: сначала обновите Boykov Services и проверьте подключение клиентов')
+print('DOCS_SALES_HUB=OK')
+PY
+code=$(mktemp -d "$root/code-XXXXXXXX")
+chmod 755 "$code"
+install -d -m 755 "$code/integrations/docs-customers" "$code/shared"
+install -m 644 integrations/docs-customers/sales-agent.mjs "$code/integrations/docs-customers/sales-agent.mjs"
+install -m 644 shared/docs-sales.js shared/docs-customers.js "$code/shared/"
+printf '{"type":"module"}\n' > "$code/package.json"
+chmod 644 "$code/package.json"
+install -d -m 700 -o "$source_uid" -g "$source_gid" "$root/state"
+python3 - "$root" "$code" "$source_dir" "$source_uid" "$source_gid" "$backup/candidate-compose.json" <<'PY'
+import json,sys
+root,code,source,uid,gid,destination=sys.argv[1:]
+service={
+ 'image':'node:24-bookworm-slim','user':uid+':'+gid,'restart':'unless-stopped',
+ 'command':['node','/connector/integrations/docs-customers/sales-agent.mjs','/config/config.json'],
+ 'environment':{'NODE_OPTIONS':'--max-old-space-size=384'},
+ 'read_only':True,'cap_drop':['ALL'],'security_opt':['no-new-privileges:true'],
+ 'mem_limit':'512m','pids_limit':64,'stop_grace_period':'180s',
+ 'tmpfs':['/tmp:rw,noexec,nosuid,size=16m'],
+ 'volumes':[
+  {'type':'bind','source':source,'target':'/source','read_only':True},
+  {'type':'bind','source':code,'target':'/connector','read_only':True},
+  {'type':'bind','source':root+'/config.json','target':'/config/config.json','read_only':True},
+  {'type':'bind','source':root+'/state','target':'/state'}],
+ 'logging':{'driver':'json-file','options':{'max-size':'5m','max-file':'2'}},
+ 'healthcheck':{'test':['CMD','node','-e',"const s=JSON.parse(require('fs').readFileSync('/state/status.json'));process.exit(Date.now()-Date.parse(s.checkedAt)<180000&&s.scanOk&&s.rejected===0&&!s.errorCode?0:1)"],'interval':'30s','timeout':'5s','start_period':'120s','retries':3}}
+with open(destination,'x') as file: json.dump({'name':'boykovdocs-sales-delivery','services':{'delivery':service}},file,indent=2)
+PY
+changed=0
+recover() {
+ result=$?
+ if [[ "$result" != 0 ]]; then
+  if [[ "$changed" == 1 ]]; then
+   docker compose -f "$root/compose.json" stop delivery || true
+   if [[ -f "$backup/compose.json" && -f "$backup/config.json" ]]; then
+    cp -p "$backup/config.json" "$root/config.json"
+    cp -p "$backup/compose.json" "$root/compose.json"
+    docker compose -f "$root/compose.json" up -d --no-deps delivery || true
+   fi
+  fi
+  printf 'DOCS_SALES_CHECK_REQUIRED BACKUP=%s\n' "$backup"
+ fi
+}
+trap recover EXIT
+# Validate and pull before stopping a previous sales collector. The website and customer collector stay running.
+docker compose -f "$backup/candidate-compose.json" config --quiet
+docker compose -f "$backup/candidate-compose.json" pull delivery
+changed=1
+if [[ -f "$root/compose.json" ]]; then docker compose -f "$root/compose.json" stop delivery; fi
+install -m 600 -o "$source_uid" -g "$source_gid" "$backup/candidate-config.json" "$root/config.json"
+install -m 600 "$backup/candidate-compose.json" "$root/compose.json"
+compose=(docker compose -f "$root/compose.json")
+"${compose[@]}" run --rm --no-deps delivery node /connector/integrations/docs-customers/sales-agent.mjs /config/config.json --once
+"${compose[@]}" up -d --no-deps --wait --wait-timeout 180 delivery
+"${compose[@]}" ps
+printf 'DOCS_SALES_CONNECTION=OK\nDOCS_SALES_DIRECTORY=%s\nBACKUP=%s\n' "$root" "$backup"
diff --git a/server/modules/docs-sales/index.js b/server/modules/docs-sales/index.js
new file mode 100644
index 0000000..277bc2d
--- /dev/null
+++ b/server/modules/docs-sales/index.js
@@ -0,0 +1,399 @@
+import { createHash } from "node:crypto";
+import { customerDate, customerText } from "../../../shared/docs-customers.js";
+import {
+  normalizeDocsSale,
+  salesRange,
+  moscowDay,
+} from "../../../shared/docs-sales.js";
+const bad = (message, status = 400) =>
+  Object.assign(new Error(message), { status });
+const hash = (v) => createHash("sha256").update(v).digest("hex");
+const wrap = (fn) => (req, res, next) =>
+  Promise.resolve()
+    .then(() => fn(req, res))
+    .catch(next);
+const transaction = (db, fn) => {
+  db.exec("BEGIN IMMEDIATE");
+  try {
+    const value = fn();
+    db.exec("COMMIT");
+    return value;
+  } catch (e) {
+    if (db.isTransaction) db.exec("ROLLBACK");
+    throw e;
+  }
+};
+export function createDocsSalesModule(
+  db,
+  { authorize, configured, now = Date.now },
+) {
+  db.exec(`CREATE TABLE IF NOT EXISTS docs_sales_purchases(id TEXT PRIMARY KEY,buyer_id TEXT NOT NULL,instruction_id TEXT NOT NULL,title TEXT NOT NULL,format TEXT NOT NULL,amount_minor INTEGER NOT NULL,created_at TEXT NOT NULL,received_at TEXT NOT NULL);
+ CREATE INDEX IF NOT EXISTS docs_sales_purchases_date ON docs_sales_purchases(created_at DESC,id);
+ CREATE UNIQUE INDEX IF NOT EXISTS docs_sales_purchases_access ON docs_sales_purchases(buyer_id,instruction_id,format);
+ CREATE INDEX IF NOT EXISTS docs_sales_purchases_buyer ON docs_sales_purchases(buyer_id,created_at DESC);
+ CREATE TABLE IF NOT EXISTS docs_sales_buyers(id TEXT PRIMARY KEY,name TEXT NOT NULL,email TEXT NOT NULL,phone TEXT NOT NULL,registered_at TEXT,observed_at TEXT NOT NULL,search_text TEXT NOT NULL);
+ CREATE TABLE IF NOT EXISTS docs_sales_receipts(event_id TEXT PRIMARY KEY,payload_hash TEXT NOT NULL,purchase_id TEXT NOT NULL,received_at TEXT NOT NULL);
+ CREATE TABLE IF NOT EXISTS docs_sales_connection(id INTEGER PRIMARY KEY CHECK(id=1),last_heartbeat_at TEXT,last_received_at TEXT,source_generated_at TEXT,source_count INTEGER NOT NULL DEFAULT 0,pending INTEGER NOT NULL DEFAULT 0,rejected INTEGER NOT NULL DEFAULT 0,scan_ok INTEGER NOT NULL DEFAULT 0,error_code TEXT NOT NULL DEFAULT '');
+ INSERT OR IGNORE INTO docs_sales_connection(id) VALUES(1);`);
+  const storedCount = () =>
+    db.prepare("SELECT count(*) n FROM docs_sales_purchases").get().n;
+  function connection() {
+    const row = db
+        .prepare("SELECT * FROM docs_sales_connection WHERE id=1")
+        .get(),
+      count = storedCount(),
+      hasKey = configured(),
+      age = row.last_heartbeat_at
+        ? now() - Date.parse(row.last_heartbeat_at)
+        : Infinity;
+    return {
+      configured: hasKey,
+      lastHeartbeatAt: row.last_heartbeat_at,
+      lastReceivedAt: row.last_received_at,
+      sourceGeneratedAt: row.source_generated_at,
+      sourceCount: row.source_count,
+      storedCount: count,
+      pending: row.pending,
+      rejected: row.rejected,
+      scanOk: !!row.scan_ok,
+      errorCode: row.error_code,
+      status: !hasKey
+        ? "unconfigured"
+        : !row.last_heartbeat_at
+          ? "waiting"
+          : age > 180000
+            ? "offline"
+            : !row.scan_ok || row.rejected || row.error_code
+              ? "attention"
+              : row.pending
+                ? "syncing"
+                : row.source_count !== count
+                  ? "attention"
+                  : "online",
+    };
+  }
+  function receive(req, res) {
+    authorize(req);
+    const e = normalizeDocsSale(req.body, now()),
+      digest = hash(JSON.stringify(e));
+    const result = transaction(db, () => {
+      const receipt = db
+        .prepare("SELECT * FROM docs_sales_receipts WHERE event_id=?")
+        .get(e.eventId);
+      if (receipt) {
+        if (receipt.payload_hash !== digest)
+          throw bad(
+            "Идентификатор покупки уже использован с другими данными.",
+            409,
+          );
+        return { duplicate: true };
+      }
+      const p = e.purchase,
+        old = db
+          .prepare("SELECT * FROM docs_sales_purchases WHERE id=?")
+          .get(p.id),
+        stamp = new Date(now()).toISOString();
+      if (
+        old &&
+        (old.buyer_id !== e.user.id ||
+          old.instruction_id !== p.instructionId ||
+          old.title !== p.title ||
+          old.format !== p.format ||
+          old.amount_minor !== p.amountMinor ||
+          old.created_at !== p.createdAt)
+      )
+        throw bad("Сохранённая покупка отличается от данных источника.", 409);
+      const access = db
+        .prepare(
+          "SELECT id FROM docs_sales_purchases WHERE buyer_id=? AND instruction_id=? AND format=?",
+        )
+        .get(e.user.id, p.instructionId, p.format);
+      if (access && access.id !== p.id)
+        throw bad(
+          "Для этого пользователя уже сохранена покупка такого формата инструкции.",
+          409,
+        );
+      const buyer = db
+          .prepare("SELECT * FROM docs_sales_buyers WHERE id=?")
+          .get(e.user.id),
+        u = e.user;
+      if (!buyer || e.observedAt > buyer.observed_at)
+        db.prepare(
+          "INSERT INTO docs_sales_buyers VALUES(?,?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET name=excluded.name,email=excluded.email,phone=excluded.phone,registered_at=COALESCE(docs_sales_buyers.registered_at,excluded.registered_at),observed_at=excluded.observed_at,search_text=excluded.search_text",
+        ).run(
+          u.id,
+          u.name,
+          u.email,
+          u.phone,
+          u.registeredAt,
+          e.observedAt,
+          [u.id, u.name, u.email, u.phone, u.phone.replace(/\D/g, "")]
+            .join(" ")
+            .toLowerCase(),
+        );
+      if (!old)
+        db.prepare(
+          "INSERT INTO docs_sales_purchases VALUES(?,?,?,?,?,?,?,?)",
+        ).run(
+          p.id,
+          u.id,
+          p.instructionId,
+          p.title,
+          p.format,
+          p.amountMinor,
+          p.createdAt,
+          stamp,
+        );
+      db.prepare("INSERT INTO docs_sales_receipts VALUES(?,?,?,?)").run(
+        e.eventId,
+        digest,
+        p.id,
+        stamp,
+      );
+      db.prepare(
+        "UPDATE docs_sales_connection SET last_received_at=? WHERE id=1",
+      ).run(stamp);
+      return { duplicate: !!old };
+    });
+    res.status(result.duplicate ? 200 : 201).json({
+      ok: true,
+      eventId: e.eventId,
+      externalId: e.user.id,
+      saleId: e.purchase.id,
+      duplicate: result.duplicate,
+    });
+  }
+  function heartbeat(req, res) {
+    authorize(req);
+    const b = req.body;
+    if (
+      !b ||
+      typeof b.scanOk !== "boolean" ||
+      !["sourceCount", "pending", "rejected"].every(
+        (k) => Number.isSafeInteger(b[k]) && b[k] >= 0,
+      ) ||
+      ![
+        "",
+        "wallet_read_failed",
+        "users_read_failed",
+        "invalid_source_data",
+        "delivery_delayed",
+        "source_count_decreased",
+      ].includes(b.errorCode || "")
+    )
+      throw bad("Некорректный статус доставки продаж.");
+    const sourceAt = customerDate(b.sourceGeneratedAt, { now: now() });
+    db.prepare(
+      "UPDATE docs_sales_connection SET last_heartbeat_at=?,source_generated_at=?,source_count=?,pending=?,rejected=?,scan_ok=?,error_code=? WHERE id=1",
+    ).run(
+      new Date(now()).toISOString(),
+      sourceAt,
+      b.sourceCount,
+      b.pending,
+      b.rejected,
+      Number(b.scanOk),
+      b.errorCode || "",
+    );
+    res.json({ ok: true, source: "boykovdocs-sales" });
+  }
+  function filters(req) {
+    const period = String(req.query.period || "total"),
+      format = String(req.query.format || "all"),
+      range = salesRange(period, now());
+    if (!["all", "pdf", "docx"].includes(format))
+      throw bad("Выберите формат инструкции.");
+    const where = ["p.created_at<=?"],
+      args = [range.end];
+    if (range.start) {
+      where.push("p.created_at>=?");
+      args.push(range.start);
+    }
+    if (format !== "all") {
+      where.push("p.format=?");
+      args.push(format);
+    }
+    return { period, format, range, where, args };
+  }
+  const condition = (f) => " WHERE " + f.where.join(" AND ");
+  function totals(f) {
+    return db
+      .prepare(
+        "SELECT count(*) count,COALESCE(SUM(p.amount_minor),0) amountMinor,count(DISTINCT p.buyer_id) buyers,count(DISTINCT p.instruction_id) instructions,COALESCE(SUM(p.format='pdf'),0) pdf,COALESCE(SUM(p.format='docx'),0) docx,MIN(p.created_at) firstPurchaseAt,MAX(p.created_at) lastPurchaseAt FROM docs_sales_purchases p" +
+          condition(f),
+      )
+      .get(...f.args);
+  }
+  function pagination(req, total) {
+    const n = Number(req.query.page || 1);
+    if (!Number.isSafeInteger(n) || n < 1 || n > 100000)
+      throw bad("Проверьте номер страницы.");
+    const pages = Math.max(1, Math.ceil(total / 25));
+    return { page: Math.min(n, pages), pages, total };
+  }
+  function buyerView(row) {
+    return {
+      id: row.id,
+      name: row.name,
+      email: row.email,
+      phone: row.phone,
+      registeredAt: row.registered_at,
+      customerId: row.customer_deleted ? null : row.customer_id || null,
+      customerInTrash: !!row.customer_deleted,
+    };
+  }
+  function chart(f, t) {
+    const start = f.range.start || t.firstPurchaseAt;
+    if (!start) return { unit: "day", items: [] };
+    const first = moscowDay(Date.parse(start)),
+      last = moscowDay(now()),
+      monthly = (Date.parse(last) - Date.parse(first)) / 86400000 > 120;
+    const unit = monthly ? "month" : "day",
+      size = monthly ? 7 : 10;
+    const rows = db
+        .prepare(
+          "SELECT substr(datetime(p.created_at,'+3 hours'),1," +
+            size +
+            ") key,count(*) count,SUM(p.amount_minor) amountMinor FROM docs_sales_purchases p" +
+            condition(f) +
+            " GROUP BY key ORDER BY key",
+        )
+        .all(...f.args),
+      byKey = new Map(rows.map((r) => [r.key, r]));
+    const items = [];
+    let cursor = first.slice(0, size),
+      limit = last.slice(0, size);
+    while (cursor <= limit) {
+      items.push(
+        byKey.get(cursor) || { key: cursor, count: 0, amountMinor: 0 },
+      );
+      cursor = monthly
+        ? new Date(
+            Date.UTC(Number(cursor.slice(0, 4)), Number(cursor.slice(5, 7)), 1),
+          )
+            .toISOString()
+            .slice(0, 7)
+        : new Date(Date.parse(cursor + "T12:00:00Z") + 86400000)
+            .toISOString()
+            .slice(0, 10);
+    }
+    return { unit, items };
+  }
+  function report(req) {
+    const f = filters(req),
+      summary = totals(f),
+      q = customerText(req.query.q, 300).toLowerCase(),
+      sort = String(req.query.sort || "purchases");
+    if (!["purchases", "amount", "recent"].includes(sort))
+      throw bad("Проверьте сортировку покупателей.");
+    const filtered = { where: [...f.where], args: [...f.args] };
+    if (q) {
+      filtered.where.push("b.search_text LIKE ? ESCAPE '\\'");
+      filtered.args.push("%" + q.replace(/[\\%_]/g, "\\$&") + "%");
+    }
+    const join =
+      " FROM docs_sales_purchases p JOIN docs_sales_buyers b ON b.id=p.buyer_id LEFT JOIN docs_customers c ON c.external_id=b.id";
+    const total = db
+        .prepare("SELECT count(DISTINCT b.id) n" + join + condition(filtered))
+        .get(...filtered.args).n,
+      page = pagination(req, total);
+    const rows = db
+      .prepare(
+        "SELECT b.*,c.id customer_id,c.deleted_at customer_deleted,count(*) purchaseCount,count(DISTINCT p.instruction_id) uniqueInstructions,SUM(p.amount_minor) amountMinor,MAX(p.created_at) lastPurchaseAt,SUM(p.format='pdf') pdf,SUM(p.format='docx') docx" +
+          join +
+          condition(filtered) +
+          " GROUP BY b.id ORDER BY " +
+          {
+            purchases:
+              "purchaseCount DESC,amountMinor DESC,lastPurchaseAt DESC",
+            amount: "amountMinor DESC,purchaseCount DESC,lastPurchaseAt DESC",
+            recent: "lastPurchaseAt DESC,purchaseCount DESC",
+          }[sort] +
+          ",b.id LIMIT 25 OFFSET ?",
+      )
+      .all(...filtered.args, (page.page - 1) * 25);
+    const topInstructions = db
+      .prepare(
+        "SELECT p.instruction_id id,p.title,count(*) count,SUM(p.amount_minor) amountMinor FROM docs_sales_purchases p" +
+          condition(f) +
+          " GROUP BY p.instruction_id ORDER BY count DESC,amountMinor DESC,p.instruction_id LIMIT 10",
+      )
+      .all(...f.args);
+    return {
+      range: f.range,
+      format: f.format,
+      summary,
+      connection: connection(),
+      chart: chart(f, summary),
+      topInstructions,
+      buyers: rows.map((r) => ({
+        ...buyerView(r),
+        purchaseCount: r.purchaseCount,
+        uniqueInstructions: r.uniqueInstructions,
+        amountMinor: r.amountMinor,
+        lastPurchaseAt: r.lastPurchaseAt,
+        pdf: r.pdf,
+        docx: r.docx,
+      })),
+      ...page,
+    };
+  }
+  function buyer(req) {
+    const id = customerText(req.params.id, 160, true),
+      row = db
+        .prepare(
+          "SELECT b.*,c.id customer_id,c.deleted_at customer_deleted FROM docs_sales_buyers b LEFT JOIN docs_customers c ON c.external_id=b.id WHERE b.id=?",
+        )
+        .get(id);
+    if (!row) throw bad("Покупатель не найден.", 404);
+    const f = filters(req);
+    f.where.push("p.buyer_id=?");
+    f.args.push(id);
+    const summary = totals(f),
+      page = pagination(req, summary.count);
+    const purchases = db
+      .prepare(
+        "SELECT id,instruction_id instructionId,title,format,amount_minor amountMinor,created_at createdAt FROM docs_sales_purchases p" +
+          condition(f) +
+          " ORDER BY p.created_at DESC,p.id LIMIT 25 OFFSET ?",
+      )
+      .all(...f.args, (page.page - 1) * 25);
+    const lifetime = totals({
+      where: ["p.buyer_id=?", "p.created_at<=?"],
+      args: [id, new Date(now()).toISOString()],
+    });
+    return {
+      buyer: buyerView(row),
+      range: f.range,
+      format: f.format,
+      summary,
+      lifetime,
+      purchases,
+      ...page,
+    };
+  }
+  function register(app) {
+    app.get(
+      "/api/docs-sales/report",
+      wrap((req, res) => res.json(report(req))),
+    );
+    app.get(
+      "/api/docs-sales/buyers/:id",
+      wrap((req, res) => res.json(buyer(req))),
+    );
+  }
+  return {
+    register,
+    connection,
+    receive: wrap(receive),
+    heartbeat: wrap(heartbeat),
+    handshake: wrap((req, res) => {
+      authorize(req);
+      res.json({
+        ok: true,
+        source: "boykovdocs-sales",
+        protocol: 1,
+        scope: "all-purchases",
+      });
+    }),
+  };
+}
diff --git a/shared/docs-sales.js b/shared/docs-sales.js
new file mode 100644
index 0000000..c073a5c
--- /dev/null
+++ b/shared/docs-sales.js
@@ -0,0 +1,76 @@
+import { customerDate, customerText } from "./docs-customers.js";
+const invalid = () =>
+  Object.assign(new Error("Проверьте данные покупки BoykovDocs."), {
+    status: 400,
+  });
+export function normalizeDocsSale(input, now = Date.now()) {
+  if (
+    !input ||
+    typeof input !== "object" ||
+    Array.isArray(input) ||
+    input.protocol !== 1
+  )
+    throw invalid();
+  const eventId = customerText(input.eventId, 160, true);
+  if (!/^[A-Za-z0-9][A-Za-z0-9_.:-]*$/.test(eventId)) throw invalid();
+  const u = input.user,
+    p = input.purchase;
+  if (!u || !p || Array.isArray(u) || Array.isArray(p)) throw invalid();
+  const id = customerText(u.id, 160, true);
+  if (!/^[A-Za-z0-9_-]+$/.test(id) || p.userId !== id) throw invalid();
+  const user = {
+    id,
+    name: customerText(u.name, 200),
+    phone: customerText(u.phone, 80),
+    email: customerText(u.email, 254),
+    registeredAt: customerDate(u.registeredAt, { nullable: true, now }),
+  };
+  if (user.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(user.email))
+    throw invalid();
+  const purchase = {
+    id: customerText(p.id, 160, true),
+    userId: id,
+    instructionId: customerText(p.instructionId, 200, true),
+    title: customerText(p.title, 500, true),
+    format: p.format === undefined ? "pdf" : p.format,
+    amountMinor: p.amountMinor,
+    currency: "RUB",
+    createdAt: customerDate(p.createdAt, { now }),
+  };
+  if (
+    !/^[A-Za-z0-9_-]+$/.test(purchase.id) ||
+    !["pdf", "docx"].includes(purchase.format) ||
+    !Number.isSafeInteger(purchase.amountMinor) ||
+    purchase.amountMinor <= 0 ||
+    purchase.amountMinor > 1000000000 ||
+    p.currency !== "RUB"
+  )
+    throw invalid();
+  return {
+    protocol: 1,
+    eventId,
+    observedAt: customerDate(input.observedAt, { now }),
+    user,
+    purchase,
+  };
+}
+export const SALES_PERIODS = {
+  today: 1,
+  "7d": 7,
+  "30d": 30,
+  "90d": 90,
+  total: null,
+};
+export const moscowDay = (ms) =>
+  new Date(ms + 10800000).toISOString().slice(0, 10);
+export function salesRange(period, now = Date.now()) {
+  if (!Object.hasOwn(SALES_PERIODS, period)) throw invalid();
+  const end = new Date(now).toISOString(),
+    days = SALES_PERIODS[period];
+  const start = days
+    ? new Date(
+        Date.parse(moscowDay(now) + "T00:00:00+03:00") - (days - 1) * 86400000,
+      ).toISOString()
+    : null;
+  return { period, start, end, timeZone: "Europe/Moscow" };
+}
