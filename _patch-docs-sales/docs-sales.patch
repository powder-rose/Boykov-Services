@@ -0,0 +1,759 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import {
+  BookOpen,
+  FileText,
+  Search,
+  ShoppingBag,
+  UsersRound,
+  X,
+} from "lucide-react";
+import { api, dateTime, errorText, number } from "../api";
+import { Empty, Loading, Notice, TitleDot } from "../components/Common";
+import { initials } from "../identity";
+import "./DocsSales.css";
+type Totals = {
+  count: number;
+  amountMinor: number;
+  buyers: number;
+  instructions: number;
+  pdf: number;
+  docx: number;
+  firstPurchaseAt: string | null;
+  lastPurchaseAt: string | null;
+};
+type Buyer = {
+  id: string;
+  name: string;
+  email: string;
+  phone: string;
+  registeredAt: string | null;
+  customerId: string | null;
+  customerInTrash: boolean;
+};
+type BuyerRow = Buyer & {
+  purchaseCount: number;
+  uniqueInstructions: number;
+  amountMinor: number;
+  lastPurchaseAt: string;
+  pdf: number;
+  docx: number;
+};
+type ChartItem = { key: string; count: number; amountMinor: number };
+type Report = {
+  range: {
+    period: string;
+    start: string | null;
+    end: string;
+    timeZone: string;
+  };
+  summary: Totals;
+  format: string;
+  connection: {
+    status: string;
+    lastHeartbeatAt: string | null;
+    lastReceivedAt: string | null;
+    sourceCount: number;
