new file mode 100644
index 0000000000000000000000000000000000000000..64c5c913886c6cbc2c2dd3fd61455c07d82d086b
--- /dev/null
+++ b/integrations/statistics/agent.mjs
@@ -0,0 +1,125 @@
+import { readFile, writeFile, mkdir, rename } from "node:fs/promises";
+import { resolve, join, dirname } from "node:path";
+import { pathToFileURL } from "node:url";
+import { randomUUID } from "node:crypto";
+import { setTimeout as delay } from "node:timers/promises";
+import { collectNative } from "./collect.mjs";
+export function statisticsEndpoint(leadsEndpoint) {
+  const u = new URL(leadsEndpoint);
+  if (
+    u.protocol !== "https:" ||
+    u.username ||
+    u.password ||
+    u.search ||
+    u.hash ||
+    !/^\/hooks\/leads\/[a-zA-Z0-9_-]+$/.test(u.pathname)
+  )
+    throw Error("INVALID_NATIVE_ENDPOINT");
+  u.pathname = u.pathname.replace("/hooks/leads/", "/hooks/statistics/");
+  return u.href;
+}
+export async function writePrivate(file, value) {
+  await mkdir(dirname(file), { recursive: true, mode: 0o700 });
+  const tmp = file + "." + randomUUID();
+  await writeFile(tmp, JSON.stringify(value), { mode: 0o600, flag: "wx" });
+  await rename(tmp, file);
+}
+export async function runNativeCycle(
+  config,
+  { fetcher = fetch, now = Date.now() } = {},
+) {
+  if (!/^[a-f0-9]{64}$/.test(config.token || ""))
+    throw Error("INVALID_NATIVE_KEY");
+  const endpoint = statisticsEndpoint(config.leadsEndpoint),
+    siteId = new URL(endpoint).pathname.split("/").at(-1);
+  const stateFile = join(config.stateDir, "last-packet.json");
+  let packet;
+  try {
+    packet = await collectNative({ ...config, now });
+    await writePrivate(stateFile, packet);
+  } catch (error) {
+    // Keep a queued complete snapshot; never replace it with an empty report.
+    let queued;
+    try {
+      queued = JSON.parse(await readFile(stateFile, "utf8"));
+    } catch {}
+    if (!queued || queued.host !== config.host || queued.source !== config.kind)
+      throw error;
+    packet = queued;
+  }
+  const response = await fetcher(endpoint, {
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+      Authorization: "Bearer " + config.token,
+    },
+    body: JSON.stringify(packet),
+    redirect: "error",
+    signal: AbortSignal.timeout(20000),
+  });
+  if (!response.ok) throw Error("NATIVE_HTTP_" + response.status);
+  const ack = await response.json();
+  if (
+    ack.ok !== true ||
+    ack.siteId !== siteId ||
+    ack.generatedAt !== packet.generatedAt
+  )
+    throw Error("INVALID_NATIVE_ACK");
+  const stale = now - Date.parse(packet.generatedAt) > 180000;
+  await writePrivate(join(config.stateDir, "status.json"), {
+    ok: !stale,
+    generatedAt: packet.generatedAt,
+    deliveredAt: new Date(now).toISOString(),
+  });
+  return { ok: !stale, generatedAt: packet.generatedAt };
+}
+if (
+  process.argv[1] &&
+  import.meta.url === pathToFileURL(resolve(process.argv[1])).href
+) {
+  process.umask(0o077);
+  const file = process.argv[2];
+  if (!file) throw Error("Usage: node agent.mjs CONFIG_JSON [--once]");
+  let config;
+  try {
+    config = JSON.parse(await readFile(file, "utf8"));
+  } catch {
+    throw Error("NATIVE_CONFIGURATION_UNREADABLE");
+  }
+  const cycle = async () => {
+    try {
+      const result = await runNativeCycle(config);
+      console.log(
+        "NATIVE_STATISTICS=" +
+          (result.ok ? "OK" : "STALE") +
+          " GENERATED_AT=" +
+          result.generatedAt,
+      );
+      return result.ok;
+    } catch (error) {
+      console.error(
+        "NATIVE_STATISTICS_CHECK_REQUIRED=" +
+          (/^[A-Z_0-9]+$/.test(error.message)
+            ? error.message
+            : "SOURCE_OR_CONNECTION_ERROR"),
+      );
+      return false;
+    }
+  };
+  if (process.argv.includes("--once"))
+    process.exitCode = (await cycle()) ? 0 : 1;
+  else {
+    const stop = new AbortController();
+    for (const signal of ["SIGINT", "SIGTERM"])
+      process.once(signal, () => stop.abort());
+    while (!stop.signal.aborted) {
+      await cycle();
+      if (!stop.signal.aborted)
+        await delay(60000, undefined, { signal: stop.signal }).catch(
+          (error) => {
+            if (error.name !== "AbortError") throw error;
+          },
+        );
+    }
+  }
+}
diff --git a/integrations/statistics/collect.mjs b/integrations/statistics/collect.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9fc72f9de7cbfe5778dc924388ee86b06df84923
--- /dev/null
+++ b/integrations/statistics/collect.mjs
@@ -0,0 +1,153 @@
+import { DatabaseSync } from "node:sqlite";
+import { createReadStream } from "node:fs";
+import { stat, readFile } from "node:fs/promises";
+import { NativeReportBuilder, cleanPath } from "../../shared/statistics.js";
+import { isBotVisit } from "./security-bots.mjs";
+export function collectAccessibility({ sourceFile, now = Date.now() }) {
+  const db = new DatabaseSync(sourceFile, { readOnly: true });
+  try {
+    db.exec("PRAGMA busy_timeout=10000; BEGIN");
+    const tables = new Set(
+      db
+        .prepare("SELECT name FROM sqlite_master WHERE type='table'")
+        .all()
+        .map((t) => t.name),
+    );
+    if (
+      !["analytics_visits", "analytics_pageviews", "leads"].every((t) =>
+        tables.has(t),
+      )
+    )
+      throw Error("NATIVE_ANALYTICS_TABLES_NOT_FOUND");
+    const titles = new Map();
+    if (tables.has("articles")) {
+      for (const row of db
+        .prepare("SELECT slug,payload FROM articles")
+        .iterate()) {
+        const payload = JSON.parse(row.payload);
+        titles.set(
+          "/blog/" + row.slug + "/",
+          typeof payload.title === "string" && payload.title.trim()
+            ? payload.title.trim()
+            : row.slug,
+        );
+      }
+      if (tables.has("article_slugs"))
+        for (const row of db
+          .prepare(
+            "SELECT s.slug,a.payload FROM article_slugs s JOIN articles a ON a.id=s.article_id",
+          )
+          .iterate()) {
+          const payload = JSON.parse(row.payload);
+          titles.set("/blog/" + row.slug + "/", payload.title || row.slug);
+        }
+    }
+    const builder = new NativeReportBuilder({
+      host: "pasport-dostupnosty.ru",
+      kind: "accessibility",
+      now,
+      articles: tables.has("articles"),
+    });
+    const first = builder.frames.at(-1).range.start,
+      end = builder.frames[0].range.end;
+    for (const row of db
+      .prepare(
+        "SELECT started_at,source FROM analytics_visits WHERE started_at>=? AND started_at<?",
+      )
+      .iterate(first, end))
+      builder.record("visits", row.started_at, { source: row.source });
+    for (const row of db
+      .prepare(
+        "SELECT path,created_at FROM analytics_pageviews WHERE created_at>=? AND created_at<?",
+      )
+      .iterate(first, end)) {
+      const p = cleanPath(row.path);
+      builder.record("views", row.created_at, {
+        path: p,
+        title: titles.get(p?.endsWith("/") ? p : p + "/"),
+      });
+    }
+    for (const row of db
+      .prepare(
+        "SELECT created_at FROM leads WHERE created_at>=? AND created_at<?",
+      )
+      .iterate(new Date(first).toISOString(), new Date(end).toISOString()))
+      builder.record("leads", Date.parse(row.created_at));
+    db.exec("COMMIT");
+    return builder.packet();
+  } finally {
+    if (db.isTransaction) db.exec("ROLLBACK");
+    db.close();
+  }
+}
+async function* jsonLines(file) {
+  const before = await stat(file);
+  if (!before.isFile()) throw Error("SOURCE_NOT_A_REGULAR_FILE");
+  if (!before.size) return;
+  let remaining = "";
+  for await (const chunk of createReadStream(file, {
+    encoding: "utf8",
+    end: before.size - 1,
+  })) {
+    remaining += chunk;
+    if (remaining.length > 5e6) throw Error("SOURCE_LINE_TOO_LARGE");
+    let newline;
+    while ((newline = remaining.indexOf("\n")) !== -1) {
+      const line = remaining.slice(0, newline).trim();
+      remaining = remaining.slice(newline + 1);
+      if (line) yield JSON.parse(line);
+    }
+  }
+  // An unfinished append is not yet a committed JSONL record; retry next cycle.
+  const after = await stat(file);
+  if (
+    after.dev !== before.dev ||
+    after.ino !== before.ino ||
+    after.size < before.size
+  )
+    throw Error("SOURCE_CHANGED_DURING_READ");
+}
+function securitySource(row) {
+  const utm =
+    row.attribution?.utm?.utm_source ||
+    row.attribution?.utm_source ||
+    row.attribution?.utmSource;
+  if (typeof utm === "string" && utm.trim()) return "utm:" + utm.slice(0, 64);
+  if (!row.referrer) return "direct";
+  try {
+    const host = new URL(row.referrer).hostname.toLowerCase();
+    return ["pasport-bezopasnosty.ru", "www.pasport-bezopasnosty.ru"].includes(
+      host,
+    )
+      ? "internal"
+      : "ref:" + host;
+  } catch {
+    return "unknown";
+  }
+}
+export async function collectSecurity({
+  sourceFile,
+  leadsFile,
+  now = Date.now(),
+}) {
+  const builder = new NativeReportBuilder({
+    host: "pasport-bezopasnosty.ru",
+    kind: "security",
+    now,
+    views: false,
+    articles: false,
+  });
+  for await (const row of jsonLines(sourceFile))
+    if (!isBotVisit(row))
+      builder.record("visits", Date.parse(row.receivedAt), {
+        source: securitySource(row),
+      });
+  for await (const row of jsonLines(leadsFile))
+    builder.record("leads", Date.parse(row.receivedAt || row.submittedAt));
+  return builder.packet();
+}
+export async function collectNative(config) {
+  if (config.kind === "accessibility") return collectAccessibility(config);
+  if (config.kind === "security") return collectSecurity(config);
+  throw Error("UNKNOWN_NATIVE_COLLECTOR");
+}
diff --git a/integrations/statistics/nwd.php b/integrations/statistics/nwd.php
new file mode 100644
index 0000000000000000000000000000000000000000..c7f17759672c9606e2c694313ab449b835acaa67
--- /dev/null
+++ b/integrations/statistics/nwd.php
@@ -0,0 +1,41 @@
+<?php
+if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
+function nwdStatisticsPeriod($key, $now) {
+    if (!in_array($key, array('24h','7','30','90'), true)) throw new RuntimeException('INVALID_NATIVE_PERIOD');
+    $end = (int)floor($now / 60) * 60;
+    $today = (int)floor(($end + 10800) / 86400) * 86400 - 10800;
+    $start = $key === '24h' ? $end - 86400 : $today - ((int)$key - 1) * 86400;
+    $step = $key === '24h' ? 3600 : 86400;
+    $first = (int)floor(($start + 10800) / $step) * $step - 10800;
+    $daily = array();
+    for ($time = $first; $time < $end; $time += $step) $daily[] = array('at'=>gmdate('Y-m-d\TH:i:s.000\Z', max($time,$start)), 'end'=>gmdate('Y-m-d\TH:i:s.000\Z', min($time+$step,$end)), 'visits'=>0,'views'=>0,'articles'=>0,'leads'=>0);
+    return array('start'=>$start,'end'=>$end,'step'=>$step,'first'=>$first,'daily'=>$daily);
+}
+function nwdStatisticsSource($value) {
+    if (strpos($value,'utm:') === 0) return 'UTM · '.substr($value,4);
+    if (strpos($value,'ref:') === 0) return substr($value,4);
+    return array('direct'=>'Прямой заход','internal'=>'Со страниц сайта','unknown'=>'Источник не определён')[$value] ?? 'Источник не определён';
+}
+function nwdStatisticsPacket($now) {
+    $reports = array();
+    $views = panelTable('panel_traffic_view');
+    $feedback = panelTable('feedback');
+    foreach (array('24h','7','30','90') as $key) {
+        $r = nwdStatisticsPeriod($key,$now); $daily = $r['daily']; $period = array($r['start'],$r['end']);
+        $rows = panelRows("SELECT FLOOR((viewed_at-?)/?) slot, COUNT(*) views,SUM(entry) visits,SUM(article_site_id>0) articles FROM $views WHERE viewed_at>=? AND viewed_at<? GROUP BY slot",array($r['first'],$r['step'],$r['start'],$r['end']));
+        foreach ($rows as $row) foreach (array('visits','views','articles') as $field) $daily[(int)$row['slot']][$field] = (int)$row[$field];
+        $rows = panelRows("SELECT FLOOR((created-?)/?) slot,COUNT(*) amount FROM $feedback WHERE trash='0' AND created>=? AND created<? GROUP BY slot",array($r['first'],$r['step'],$r['start'],$r['end']));
+        foreach ($rows as $row) $daily[(int)$row['slot']]['leads']=(int)$row['amount'];
+        $totals = array(); foreach(array('visits','views','articles','leads') as $field) $totals[$field]=array_sum(array_column($daily,$field));
+        $sources = array();
+        foreach(panelRows("SELECT source,COUNT(*) amount FROM $views WHERE viewed_at>=? AND viewed_at<? AND entry=1 GROUP BY source ORDER BY amount DESC,source LIMIT 20",$period) as $row) {
+            $label=nwdStatisticsSource($row['source']);$sources[$label]=($sources[$label] ?? 0)+(int)$row['amount'];
+        }
+        $sourceRows=array();foreach($sources as $name=>$amount)$sourceRows[]=array('name'=>$name,'visits'=>$amount);
+        $pages=array();foreach(panelRows("SELECT path,COUNT(*) amount FROM $views WHERE viewed_at>=? AND viewed_at<? GROUP BY path ORDER BY amount DESC,path LIMIT 20",$period) as $row)$pages[]=array('path'=>$row['path'],'title'=>$row['path'],'views'=>(int)$row['amount']);
+        $ranked=panelRows("SELECT ranked.path,ranked.amount,a.title FROM (SELECT article_site_id,MIN(path) path,COUNT(*) amount FROM $views WHERE viewed_at>=? AND viewed_at<? AND article_site_id>0 GROUP BY article_site_id ORDER BY amount DESC,article_site_id LIMIT 20) ranked LEFT JOIN ".panelTable('panel_article')." a ON a.site_id=ranked.article_site_id ORDER BY ranked.amount DESC,ranked.article_site_id",$period);
+        $articles=array();foreach($ranked as $row){$p=$row['path'];if(isset($articles[$p]))$articles[$p]['views']+=(int)$row['amount'];else $articles[$p]=array('path'=>$p,'title'=>$row['title'] ?: $p,'views'=>(int)$row['amount']);}
+        $reports[]=array('key'=>$key,'period'=>array('from'=>gmdate('Y-m-d\TH:i:s.000\Z',$r['start']),'to'=>gmdate('Y-m-d\TH:i:s.000\Z',$r['end']),'group'=>$key==='24h'?'hour':'day'),'totals'=>$totals,'daily'=>$daily,'sources'=>$sourceRows,'pages'=>$pages,'articles'=>array_values($articles));
+    }
+    return array('version'=>1,'host'=>'nwdelectricity.ru','source'=>'nwd','generatedAt'=>gmdate('Y-m-d\TH:i:s.000\Z',(int)floor($now/60)*60),'reports'=>$reports);
+}
diff --git a/integrations/statistics/run-nwd.php b/integrations/statistics/run-nwd.php
new file mode 100644
index 0000000000000000000000000000000000000000..066293b0d3147b6ae6b523608ff62e2abbd26020
--- /dev/null
+++ b/integrations/statistics/run-nwd.php
@@ -0,0 +1,36 @@
+<?php
+if (PHP_SAPI !== 'cli' || PHP_VERSION_ID < 70300 || $argc !== 2) exit(2);
+umask(0077);
+require __DIR__.'/nwd.php';
+$config=require $argv[1];
+if (!isset($config['root'],$config['state_dir'],$config['endpoint'],$config['token']) || !preg_match('/^[a-f0-9]{64}$/D',$config['token'])) exit(2);
+$url=parse_url($config['endpoint']);
+if (!$url || $url['scheme']!=='https' || isset($url['user']) || isset($url['pass']) || isset($url['query']) || isset($url['fragment']) || ($url['path'] ?? '')!=='/hooks/leads/nwd') exit(2);
+$endpoint='https://'.$url['host'].(isset($url['port'])?':'.$url['port']:'').'/hooks/statistics/nwd';
+$state=rtrim($config['state_dir'],'/').'/statistics';
+if (!is_dir($state) && !mkdir($state,0700,true)) exit(1);
+$lock=fopen($state.'/sync.lock','c');if(!$lock || !flock($lock,LOCK_EX|LOCK_NB))exit(0);
+$packet=null;
+try {
+    define('NWD_PANEL',true);
+    require $config['root'].'/redaktsiya/lib/db.php';
+    $db=panelDb();
+    $db->begin_transaction(MYSQLI_TRANS_START_READ_ONLY | MYSQLI_TRANS_START_WITH_CONSISTENT_SNAPSHOT);
+    try { $packet=nwdStatisticsPacket(time()); $db->commit(); } catch(Throwable $e) { $db->rollback(); throw $e; }
+    $json=json_encode($packet,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR);
+    $tmp=tempnam($state,'.packet-');if(file_put_contents($tmp,$json,LOCK_EX)===false)throw new RuntimeException('STATE_WRITE_FAILED');chmod($tmp,0600);if(!rename($tmp,$state.'/last-packet.json'))throw new RuntimeException('STATE_WRITE_FAILED');
+} catch (Throwable $error) {
+    $json=@file_get_contents($state.'/last-packet.json');
+    $packet=is_string($json)?json_decode($json,true):null;
+    if(!is_array($packet) || ($packet['host'] ?? '')!=='nwdelectricity.ru'){echo "NWD_STATISTICS=SOURCE_CHECK_REQUIRED\n";exit(1);}
+}
+$status=0;
+try {
+    $curl=curl_init($endpoint);
+    curl_setopt_array($curl,array(CURLOPT_POST=>true,CURLOPT_POSTFIELDS=>$json,CURLOPT_HTTPHEADER=>array('Content-Type: application/json','Authorization: Bearer '.$config['token']),CURLOPT_RETURNTRANSFER=>true,CURLOPT_FOLLOWLOCATION=>false,CURLOPT_CONNECTTIMEOUT=>5,CURLOPT_TIMEOUT=>20,CURLOPT_SSL_VERIFYPEER=>true,CURLOPT_SSL_VERIFYHOST=>2));
+    $body=curl_exec($curl);$status=(int)curl_getinfo($curl,CURLINFO_HTTP_CODE);curl_close($curl);
+    $ack=is_string($body)?json_decode($body,true):null;
+    if(!in_array($status,array(200,201),true) || !is_array($ack) || ($ack['ok'] ?? false)!==true || ($ack['siteId'] ?? '')!=='nwd' || ($ack['generatedAt'] ?? '')!==$packet['generatedAt'])throw new RuntimeException('DELIVERY_NOT_CONFIRMED');
+    if(time()-strtotime($packet['generatedAt'])>180){echo "NWD_STATISTICS=STALE\n";exit(1);}
+    echo 'NWD_STATISTICS=OK GENERATED_AT='.$packet['generatedAt']."\n";
+} catch(Throwable $error){echo 'NWD_STATISTICS=DELIVERY_CHECK_REQUIRED HTTP='.$status."\n";exit(1);}
diff --git a/integrations/statistics/security-bots.mjs b/integrations/statistics/security-bots.mjs
