+++ b/server/modules/statistics/index.js
@@ -0,0 +1,356 @@
+import path from "node:path";
+import { mkdir, readFile, writeFile, rename, unlink } from "node:fs/promises";
+import { randomUUID, createHash } from "node:crypto";
+import { MetrikaClient } from "./metrika.js";
+import { defaults, validateSettings, reportPeriod } from "./period.js";
+
+const bad = (message, status = 400) =>
+  Object.assign(new Error(message), { status });
+const wrap = (fn) => (req, res, next) =>
+  Promise.resolve()
+    .then(() => fn(req, res))
+    .catch(next);
+export async function createStatisticsModule(db, options) {
+  db.exec(`CREATE TABLE IF NOT EXISTS statistics_settings (
+    site_id TEXT PRIMARY KEY,counter_ids TEXT NOT NULL,article_prefixes TEXT NOT NULL,
+    include_subdomains INTEGER NOT NULL DEFAULT 0,version INTEGER NOT NULL DEFAULT 1,verified_at TEXT);
+    CREATE TABLE IF NOT EXISTS statistics_cache (
+      site_id TEXT NOT NULL,period TEXT NOT NULL,signature TEXT NOT NULL,report TEXT NOT NULL,fetched_at INTEGER NOT NULL,
+      PRIMARY KEY(site_id,period));`);
+  const now = options.now || Date.now,
+    client = new MetrikaClient({ fetcher: options.statisticsFetch || fetch });
+  const privateDirectory = path.join(options.dataDir, "statistics");
+  const secretFile = path.join(privateDirectory, "metrika.json");
+  let credentials = null;
+  try {
+    const saved = JSON.parse(await readFile(secretFile, "utf8"));
+    if (typeof saved.token === "string" && typeof saved.revision === "string")
+      credentials = saved;
+  } catch {}
+  if (options.statisticsToken)
+    credentials = { token: options.statisticsToken, revision: "fixture" };
+  let counterList = [],
+    counterListAt = 0;
+  const inflight = new Map(),
+    failures = new Map();
+  function site(id) {
+    const row = db
+      .prepare("SELECT id,name,host,created_at FROM sales_sites WHERE id=?")
+      .get(id);
+    if (!row) throw bad("Сайт не найден.", 404);
+    return row;
+  }
+  function settings(id) {
+    const s = site(id),
+      preset = defaults(s.host);
+    db.prepare(
+      "INSERT OR IGNORE INTO statistics_settings(site_id,counter_ids,article_prefixes,include_subdomains) VALUES(?,?,?,?)",
+    ).run(
+      id,
+      JSON.stringify(preset.counterIds),
+      JSON.stringify(preset.articlePrefixes),
+      Number(preset.includeSubdomains),
+    );
+    const row = db
+      .prepare("SELECT * FROM statistics_settings WHERE site_id=?")
+      .get(id);
+    return {
+      counterIds: JSON.parse(row.counter_ids),
+      articlePrefixes: JSON.parse(row.article_prefixes),
+      includeSubdomains: !!row.include_subdomains,
+      version: row.version,
+      verifiedAt: row.verified_at,
+    };
+  }
+  function list() {
+    return db
+      .prepare("SELECT id FROM sales_sites ORDER BY name COLLATE NOCASE,host")
+      .all()
+      .map(({ id }) => {
+        const s = site(id),
+          p = settings(id);
+        return {
+          ...s,
+          settings: p,
+          connected: !!(credentials && p.verifiedAt),
+        };
+      });
+  }
+  async function counters() {
+    if (!credentials) throw bad("Подключите доступ к Яндекс Метрике.", 409);
+    if (now() - counterListAt > 300000 || !counterListAt) {
+      counterList = await client.counters(credentials.token);
+      counterListAt = now();
+    }
+    return counterList;
+  }
+  async function connect(token) {
+    if (typeof token !== "string" || !/^[\x21-\x7e]{20,4096}$/.test(token))
+      throw bad("Вставьте токен без пробелов и префикса OAuth.");
+    const accessible = await client.counters(token),
+      revision = randomUUID();
+    if (!accessible.length)
+      throw bad(
+        "У этого аккаунта нет доступных счётчиков Метрики. Проверьте аккаунт Яндекса и права просмотра.",
+        403,
+      );
+    await mkdir(privateDirectory, { recursive: true, mode: 0o700 });
+    const temporary = path.join(privateDirectory, ".metrika-" + randomUUID());
+    try {
+      await writeFile(temporary, JSON.stringify({ token, revision }), {
+        mode: 0o600,
+        flag: "wx",
+      });
+      await rename(temporary, secretFile);
+    } catch (error) {
+      await unlink(temporary).catch(() => {});
+      throw bad("Не удалось сохранить подключение Метрики.", 500);
+    }
+    credentials = { token, revision };
+    counterList = accessible;
+    counterListAt = now();
+    db.exec("BEGIN IMMEDIATE");
+    try {
+      for (const s of list()) {
+        const ids = s.settings.counterIds;
+        const verified =
+          ids.length &&
+          ids.every((id) =>
+            accessible.some((c) => c.id === id && c.status !== "Deleted"),
+          );
+        db.prepare(
+          "UPDATE statistics_settings SET verified_at=?,version=version+1 WHERE site_id=?",
+        ).run(verified ? new Date(now()).toISOString() : null, s.id);
+      }
+      db.exec("DELETE FROM statistics_cache; COMMIT");
+      failures.clear();
+    } catch (error) {
+      db.exec("ROLLBACK");
+      throw error;
+    }
+    return { ok: true, counters: accessible.length };
+  }
+  async function saveSettings(id, input) {
+    const old = settings(id),
+      next = validateSettings(input);
+    if (input.version !== old.version)
+      throw bad("Подключение уже изменилось. Обновите страницу.", 409);
+    if (!credentials) throw bad("Сначала подключите доступ к Метрике.", 409);
+    const revision = credentials.revision;
+    await client.verify(next.counterIds, credentials.token);
+    if (credentials.revision !== revision)
+      throw bad("Токен изменился. Повторите сохранение.", 409);
+    const result = db
+      .prepare(
+        "UPDATE statistics_settings SET counter_ids=?,article_prefixes=?,include_subdomains=?,verified_at=?,version=version+1 WHERE site_id=? AND version=?",
+      )
+      .run(
+        JSON.stringify(next.counterIds),
+        JSON.stringify(next.articlePrefixes),
+        Number(next.includeSubdomains),
+        new Date(now()).toISOString(),
+        id,
+        old.version,
+      );
+    if (result.changes !== 1)
+      throw bad("Подключение уже изменилось. Обновите страницу.", 409);
+    db.prepare("DELETE FROM statistics_cache WHERE site_id=?").run(id);
+    for (const key of failures.keys())
+      if (key.startsWith(id + ":")) failures.delete(key);
+    return { ok: true };
+  }
+  function signature(s, p) {
+    return createHash("sha256")
+      .update(
+        JSON.stringify([
+          s.host,
+          p.counterIds,
+          p.articlePrefixes,
+          p.includeSubdomains,
+          p.version,
+          credentials?.revision,
+        ]),
+      )
+      .digest("hex");
+  }
+  function leads(id, range) {
+    const total = db
+      .prepare(
+        "SELECT COUNT(*) amount FROM sales_leads WHERE site_id=? AND created_at>=? AND created_at<?",
+      )
+      .get(id, range.from, range.to).amount;
+    const step = range.group === "hour" ? 3600000 : 86400000,
+      first = range.buckets[0]?.key || range.start;
+    const rows = db
+      .prepare(
+        "SELECT CAST((unixepoch(created_at)*1000-?)/? AS INTEGER) slot,COUNT(*) amount FROM sales_leads WHERE site_id=? AND created_at>=? AND created_at<? GROUP BY slot",
+      )
+      .all(first, step, id, range.from, range.to);
+    const slots = new Map(rows.map((r) => [r.slot, r.amount]));
+    return { total, slots };
+  }
+  function emptyTraffic(range) {
+    return {
+      totals: { visits: null, views: null, articles: null },
+      daily: range.buckets.map((b) => ({
+        at: new Date(b.from).toISOString(),
+        end: new Date(b.to).toISOString(),
+        visits: null,
+        views: null,
+        articles: null,
+      })),
+      sources: [],
+      pages: [],
+      articles: [],
+      sampled: false,
+      dataLag: 0,
+      truncated: false,
+      provider: "Яндекс Метрика",
+    };
+  }
+  async function report(id, key) {
+    const s = site(id),
+      p = settings(id),
+      range = reportPeriod(key, now()),
+      sig = signature(s, p),
+      cacheKey = id + ":" + key;
+    const saved = db
+      .prepare(
+        "SELECT * FROM statistics_cache WHERE site_id=? AND period=? AND signature=?",
+      )
+      .get(id, key, sig);
+    let value = saved ? JSON.parse(saved.report) : null,
+      status = "ready",
+      error = null,
+      fetchedAt = saved?.fetched_at || null;
+    const ttl = key === "24h" ? 120000 : 600000;
+    const connected = !!(credentials && p.verifiedAt);
+    if (!connected) {
+      value = { traffic: emptyTraffic(range), range };
+      status = "unconfigured";
+    } else if (
+      !saved ||
+      now() - saved.fetched_at >= ttl ||
+      saved.fetched_at > now() ||
+      (key !== "24h" &&
+        (value.range.date1 !== range.date1 ||
+          value.range.date2 !== range.date2))
+    ) {
+      const failed = failures.get(cacheKey);
+      if (failed && failed.until > now()) {
+        error = failed.message;
+        status = saved ? "stale" : "error";
+      } else {
+        const flightKey = cacheKey + ":" + sig;
+        if (!inflight.has(flightKey)) {
+          const credential = credentials;
+          const pending = (async () => {
+            const traffic = await client.report(s, p, range, credential.token);
+            if (signature(site(id), settings(id)) !== sig)
+              throw bad("Подключение изменилось. Обновите отчёт.", 409);
+            const output = { traffic, range },
+              time = now();
+            db.prepare(
+              "INSERT INTO statistics_cache(site_id,period,signature,report,fetched_at) VALUES(?,?,?,?,?) ON CONFLICT(site_id,period) DO UPDATE SET signature=excluded.signature,report=excluded.report,fetched_at=excluded.fetched_at",
+            ).run(id, key, sig, JSON.stringify(output), time);
+            failures.delete(cacheKey);
+            return { value: output, fetchedAt: time };
+          })().finally(() => inflight.delete(flightKey));
+          inflight.set(flightKey, pending);
+        }
+        try {
+          const result = await inflight.get(flightKey);
+          value = result.value;
+          fetchedAt = result.fetchedAt;
+        } catch (e) {
+          error = e.message;
+          failures.set(cacheKey, { message: error, until: now() + 60000 });
+          status = saved ? "stale" : "error";
+        }
+      }
+    }
+    if (!value) value = { traffic: emptyTraffic(range), range };
+    const local = leads(id, value.range),
+      t = value.traffic;
+    return {
+      site: { id: s.id, name: s.name, host: s.host },
+      period: {
+        key,
+        from: value.range.from,
+        to: value.range.to,
+        group: value.range.group,
+      },
+      status,
+      error,
+      fetchedAt: fetchedAt ? new Date(fetchedAt).toISOString() : null,
+      checkedAt: new Date(now()).toISOString(),
+      refreshSeconds: 30,
+      trafficRefreshSeconds: ttl / 1000,
+      provider: t.provider,
+      dataLag: t.dataLag,
+      sampled: t.sampled,
+      truncated: t.truncated,
+      totals: { ...t.totals, leads: local.total },
+      daily: t.daily.map((d, i) => ({ ...d, leads: local.slots.get(i) || 0 })),
+      sources: t.sources,
+      pages: t.pages,
+      articles: t.articles,
+      articlePrefixes: p.articlePrefixes,
+      leadsSince: s.created_at,
+      counterIds: p.counterIds,
+    };
+  }
+  const admin = (req) => {
+    if (req.actor?.role !== "admin")
+      throw bad("Настраивать статистику может администратор.", 403);
+  };
+  function register(app) {
+    app.use("/api/statistics", (req, res, next) => {
+      res.set("Cache-Control", "private, no-store");
+      next();
+    });
+    app.get(
+      "/api/statistics/sites",
+      wrap((req, res) =>
+        res.json({
+          sites: list(),
+          oauthConfigured: !!credentials,
+          canConfigure: req.actor?.role === "admin",
+        }),
+      ),
+    );
+    app.get(
+      "/api/statistics/report",
+      wrap(async (req, res) =>
+        res.json(
+          await report(
+            String(req.query.site || ""),
+            String(req.query.period || "30"),
+          ),
+        ),
+      ),
+    );
+    app.get(
+      "/api/statistics/counters",
+      wrap(async (req, res) => {
+        admin(req);
+        res.json({ counters: await counters() });
+      }),
+    );
+    app.post(
+      "/api/statistics/connection",
+      wrap(async (req, res) => {
+        admin(req);
+        res.json(await connect(req.body?.token));
+      }),
+    );
+    app.patch(
+      "/api/statistics/sites/:id",
+      wrap(async (req, res) => {
+        admin(req);
+        res.json(await saveSettings(req.params.id, req.body));
+      }),
+    );
+  }
+  return { register, connect, report, list, saveSettings };
+}
diff --git a/server/modules/statistics/metrika.js b/server/modules/statistics/metrika.js
new file mode 100644
index 0000000000000000000000000000000000000000..77bf7f64861a8cbb8b81ad753335aa510778b05a
--- /dev/null
+++ b/server/modules/statistics/metrika.js
@@ -0,0 +1,291 @@
+import { moscowText, parseMoscow, hostMatches } from "./period.js";
+
+const ORIGIN = "https://api-metrika.yandex.net";
+const failure = (message, status = 503) =>
+  Object.assign(new Error(message), { status });
+const escapeRegex = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+const count = (value) => {
+  if (typeof value !== "number" || !Number.isFinite(value) || value < 0)
+    throw failure("Метрика вернула некорректные значения.");
+  return Math.round(value);
+};
+const sourceLabels = {
+  direct: "Прямой заход",
+  organic: "Поисковые системы",
+  referral: "Переходы с сайтов",
+  internal: "Со страниц сайта",
+  ad: "Реклама",
+  social: "Социальные сети",
+  messenger: "Мессенджеры",
+  recommend: "Рекомендательные системы",
+  saved: "Сохранённые страницы",
+};
+
+export class MetrikaClient {
+  constructor({ fetcher = fetch, timeout = 12000 } = {}) {
+    this.fetcher = fetcher;
+    this.timeout = timeout;
+    this.active = 0;
+    this.waiting = [];
+    this.cooldown = 0;
+  }
+  async request(route, params, token) {
+    if (Date.now() < this.cooldown)
+      throw failure(
+        "Метрика ограничила частоту запросов. Данные обновятся после паузы.",
+      );
+    if (this.active >= 2)
+      await new Promise((resolve) => this.waiting.push(resolve));
+    else this.active++;
+    try {
+      if (Date.now() < this.cooldown)
+        throw failure(
+          "Метрика ограничила частоту запросов. Данные обновятся после паузы.",
+        );
+      const url = new URL(route, ORIGIN);
+      for (const [key, value] of Object.entries(params || {}))
+        url.searchParams.set(key, String(value));
+      let response;
+      try {
+        response = await this.fetcher(url, {
+          headers: { Authorization: "OAuth " + token },
+          signal: AbortSignal.timeout(this.timeout),
+          redirect: "error",
+        });
+      } catch {
+        throw failure(
+          "Не удалось получить данные Метрики. Сохранённый отчёт остаётся доступен.",
+        );
+      }
+      if (response.status === 401 || response.status === 403)
+        throw failure(
+          "Нет доступа к счётчику. Проверьте токен Метрики и права аккаунта.",
+          403,
+        );
+      if (response.status === 429) {
+        this.cooldown = Date.now() + 60000;
+        throw failure(
+          "Достигнут лимит запросов Метрики. Повторим после паузы.",
+        );
+      }
+      if (!response.ok)
+        throw failure(
+          response.status === 400
+            ? "Метрика отклонила параметры отчёта. Проверьте подключение."
+            : "Метрика временно недоступна.",
+        );
+      const text = await response.text();
+      if (Buffer.byteLength(text) > 5000000)
+        throw failure("Ответ Метрики слишком большой.");
+      try {
+        return JSON.parse(text);
+      } catch {
+        throw failure("Не удалось прочитать ответ Метрики.");
+      }
+    } finally {
+      const next = this.waiting.shift();
+      if (next) next();
+      else this.active--;
+    }
+  }
+  async counters(token) {
+    const result = await this.request(
+      "/management/v1/counters",
+      { per_page: 1000 },
+      token,
+    );
+    if (!Array.isArray(result.counters))
+      throw failure("Не удалось прочитать список счётчиков.");
+    return result.counters.map((c) => ({
+      id: String(c.id),
+      name: String(c.name || c.site || c.id),
+      site: String(c.site2?.site || c.site || ""),
+      status: c.status,
+    }));
+  }
+  async verify(ids, token) {
+    for (const id of ids) {
+      const data = await this.request(
+        "/management/v1/counter/" + id,
+        {},
+        token,
+      );
+      if (String(data.counter?.id) !== id || data.counter?.status === "Deleted")
+        throw failure("Этот счётчик недоступен.", 400);
+    }
+  }
+  filters(site, settings, range, kind, articles = false) {
+    const field = kind === "s" ? "ym:s:startURLDomain" : "ym:pv:URLDomain";
+    const domain = site.host.split(".").map(escapeRegex).join("[.]");
+    const hostPattern = settings.includeSubdomains
+      ? "(^|[.])" + domain + "$"
+      : "^(www[.])?" + domain + "$";
+    let filter = `${field}=~'${hostPattern}' AND ym:${kind}:dateTime>='${moscowText(range.start)}' AND ym:${kind}:dateTime<'${moscowText(range.end)}'`;
+    if (articles) {
+      const paths = settings.articlePrefixes.map(escapeRegex).join("|");
+      filter += ` AND ym:pv:URLPath=~'^(?:${paths})[^/]+/?$'`;
+    }
+    return filter;
+  }
+  async report(site, settings, range, token) {
+    const common = {
+      ids: settings.counterIds.join(","),
+      date1: range.date1,
+      date2: range.date2,
+      timezone: "+03:00",
+      accuracy: "full",
+      lang: "ru",
+      include_undefined: true,
+    };
+    const series = (kind, articles = false) =>
+      this.request(
+        "/stat/v1/data/bytime",
+        {
+          ...common,
+          metrics: kind === "s" ? "ym:s:visits" : "ym:pv:pageviews",
+          group: range.group,
+          filters: this.filters(site, settings, range, kind, articles),
+        },
+        token,
+      );
+    const table = (kind, dimensions, extra = {}, articles = false) =>
+      this.request(
+        "/stat/v1/data",
+        {
+          ...common,
+          metrics: kind === "s" ? "ym:s:visits" : "ym:pv:pageviews",
+          dimensions,
+          sort: kind === "s" ? "-ym:s:visits" : "-ym:pv:pageviews",
+          filters: this.filters(site, settings, range, kind, articles),
+          limit: 1000,
+          ...extra,
+        },
+        token,
+      );
+    const hasArticles = settings.articlePrefixes.length > 0;
+    const data = await Promise.all([
+      series("s"),
+      series("pv"),
+      table(
+        "s",
+        "ym:s:lastTrafficSource,ym:s:lastSearchEngineRoot,ym:s:lastReferalSource",
+      ),
+      table("pv", "ym:pv:URLDomain,ym:pv:URLPath"),
+      hasArticles ? series("pv", true) : null,
+      hasArticles
+        ? table("pv", "ym:pv:URLDomain,ym:pv:URLPath,ym:pv:title", {}, true)
+        : null,
+    ]);
+    const toSeries = (response) => {
+      if (
+        !Array.isArray(response.time_intervals) ||
+        !Array.isArray(response.data)
+      )
+        throw failure("Метрика вернула неполный график.");
+      const values = response.data[0]?.metrics?.[0] || [];
+      if (
+        response.time_intervals.length !== values.length &&
+        response.data.length
+      )
+        throw failure("Метрика вернула неполный график.");
+      const result = new Map();
+      response.time_intervals.forEach((interval, i) => {
+        if (!Array.isArray(interval))
+          throw failure("Некорректный интервал графика.");
+        result.set(parseMoscow(interval[0]), count(values[i] ?? 0));
+      });
+      return result;
+    };
+    const visits = toSeries(data[0]),
+      views = toSeries(data[1]),
+      articleViews = hasArticles ? toSeries(data[4]) : null;
+    const daily = range.buckets.map((b) => ({
+      at: new Date(b.from).toISOString(),
+      end: new Date(b.to).toISOString(),
+      visits: visits.get(b.key) || 0,
+      views: views.get(b.key) || 0,
+      articles: articleViews ? articleViews.get(b.key) || 0 : null,
+    }));
+    const totals = {
+      visits: daily.reduce((n, r) => n + r.visits, 0),
+      views: daily.reduce((n, r) => n + r.views, 0),
+      articles: articleViews ? daily.reduce((n, r) => n + r.articles, 0) : null,
+    };
+    if (
+      !Array.isArray(data[2].data) ||
+      !Array.isArray(data[3].data) ||
+      (hasArticles && !Array.isArray(data[5].data))
+    )
+      throw failure("Метрика вернула неполные таблицы.");
+    const sourceMap = new Map();
+    for (const row of data[2].data) {
+      const type = row.dimensions?.[0]?.id,
+        engine = row.dimensions?.[1]?.name,
+        ref = row.dimensions?.[2]?.name;
+      let name =
+        sourceLabels[type] ||
+        row.dimensions?.[0]?.name ||
+        "Источник не определён";
+      if (type === "organic" && engine && engine !== "Не определено")
+        name = engine;
+      if (type === "referral" && ref) {
+        try {
+          name = new URL(ref.includes("://") ? ref : "https://" + ref).hostname;
+        } catch {
+          name = "Переходы с сайтов";
+        }
+      }
+      sourceMap.set(name, (sourceMap.get(name) || 0) + count(row.metrics?.[0]));
+    }
+    const sources = [...sourceMap]
+      .map(([name, visits]) => ({ name, visits }))
+      .sort((a, b) => b.visits - a.visits || a.name.localeCompare(b.name));
+    const pages = (response, article = false) => {
+      const grouped = new Map();
+      for (const row of response.data) {
+        const host = String(
+            row.dimensions?.[0]?.name || site.host,
+          ).toLowerCase(),
+          raw = String(row.dimensions?.[1]?.name || "/");
+        if (
+          !hostMatches(host, site.host, settings.includeSubdomains) ||
+          !raw.startsWith("/") ||
+          raw.startsWith("//") ||
+          /[\u0000-\u001f]/.test(raw)
+        )
+          continue;
+        const url = new URL(raw, "https://" + host);
+        if (url.hostname !== host) continue;
+        url.search = "";
+        url.hash = "";
+        const key = url.href,
+          old = grouped.get(key);
+        const views = count(row.metrics?.[0]);
+        if (old) old.views += views;
+        else
+          grouped.set(key, {
+            path: (host === site.host ? "" : host) + url.pathname,
+            url: key,
+            title: article
+              ? String(row.dimensions?.[2]?.name || url.pathname)
+              : url.pathname,
+            views,
+          });
+      }
+      return [...grouped.values()]
+        .sort((a, b) => b.views - a.views || a.path.localeCompare(b.path))
+        .slice(0, 20);
+    };
+    return {
+      totals,
+      daily,
+      sources: sources.slice(0, 12),
+      pages: pages(data[3]),
+      articles: hasArticles ? pages(data[5], true) : [],
+      sampled: data.some((r) => r?.sampled === true),
+      dataLag: Math.max(0, ...data.map((r) => Number(r?.data_lag) || 0)),
+      truncated: data.some((r) => r && Number(r.total_rows) > 1000),
+      provider: "Яндекс Метрика",
+    };
+  }
+}
diff --git a/server/modules/statistics/period.js b/server/modules/statistics/period.js
new file mode 100644
index 0000000000000000000000000000000000000000..b54e71a30d33b090e51880d6841647c65dd77b1e
--- /dev/null
+++ b/server/modules/statistics/period.js
@@ -0,0 +1,106 @@
+const DAY = 86400000,
+  HOUR = 3600000,
+  OFFSET = 3 * HOUR;
+export const periods = ["24h", "7", "30", "90"];
+export const moscowText = (ms) =>
+  new Date(ms + OFFSET).toISOString().slice(0, 19).replace("T", " ");
+export function reportPeriod(key, now = Date.now()) {
+  if (!periods.includes(key))
+    throw Object.assign(new Error("Выберите доступный период отчёта."), {
+      status: 400,
+    });
+  const end = Math.floor(now / 60000) * 60000;
+  const today = Math.floor((end + OFFSET) / DAY) * DAY - OFFSET;
+  const start = key === "24h" ? end - DAY : today - (Number(key) - 1) * DAY;
+  const step = key === "24h" ? HOUR : DAY;
+  const first = Math.floor((start + OFFSET) / step) * step - OFFSET;
+  const buckets = [];
+  for (let time = first; time < end; time += step)
+    buckets.push({
+      key: time,
+      from: Math.max(time, start),
+      to: Math.min(time + step, end),
+    });
+  return {
+    key,
+    start,
+    end,
+    from: new Date(start).toISOString(),
+    to: new Date(end).toISOString(),
+    date1: moscowText(start).slice(0, 10),
+    date2: moscowText(Math.max(start, end - 1)).slice(0, 10),
+    group: key === "24h" ? "hour" : "day",
+    buckets,
+  };
+}
+export function parseMoscow(value) {
+  if (typeof value !== "string") throw new Error("INVALID_METRIKA_TIME");
+  const normalized =
+    value.length === 10 ? value + "T00:00:00+03:00" : value.replace(" ", "T");
+  const ms = Date.parse(
+    /(?:Z|[+-]\d\d:\d\d)$/.test(normalized)
+      ? normalized
+      : normalized + "+03:00",
+  );
+  if (!Number.isFinite(ms)) throw new Error("INVALID_METRIKA_TIME");
+  return ms;
+}
+export function defaults(host) {
+  const presets = {
+    "nwdelectricity.ru": [["114341229"], ["/articles/", "/zhurnal/"]],
+    "pasport-dostupnosty.ru": [["114185674"], ["/blog/"]],
+    "pasport-bezopasnosty.ru": [["112564818"], ["/blog/"]],
+    "boykovgroup.ru": [["106986222"], []],
+    "energo-365.ru": [["87477971", "113826112"], []],
+    "elektrolaboratoriya-techotchet.ru": [["113216650"], []],
+  };
+  const preset = presets[host] || [[], []];
+  return {
+    counterIds: preset[0],
+    articlePrefixes: preset[1],
+    includeSubdomains: host === "energo-365.ru",
+  };
+}
+export function validateSettings(input) {
+  if (
+    !input ||
+    !Array.isArray(input.counterIds) ||
+    !input.counterIds.length ||
+    input.counterIds.length > 10 ||
+    input.counterIds.some(
+      (id) => typeof id !== "string" || !/^[1-9]\d{3,11}$/.test(id),
+    ) ||
+    new Set(input.counterIds).size !== input.counterIds.length
+  )
+    throw Object.assign(
+      new Error("Укажите от одного до десяти разных номеров счётчиков."),
+      { status: 400 },
+    );
+  if (
+    !Array.isArray(input.articlePrefixes) ||
+    input.articlePrefixes.length > 10 ||
+    input.articlePrefixes.some(
+      (p) =>
+        typeof p !== "string" ||
+        p.length > 200 ||
+        !/^\/(?:[\p{L}\p{N}_-]+\/)+$/u.test(p),
+    ) ||
+    typeof input.includeSubdomains !== "boolean"
+  )
+    throw Object.assign(
+      new Error("Проверьте разделы статей и настройку поддоменов."),
+      { status: 400 },
+    );
+  return {
+    counterIds: input.counterIds,
+    articlePrefixes: [...new Set(input.articlePrefixes)],
+    includeSubdomains: input.includeSubdomains,
+  };
+}
+export function hostMatches(host, site, includeSubdomains) {
+  return (
+    host === site ||
+    host === "www." + site ||
+    (includeSubdomains && host.endsWith("." + site))
+  );
+}
