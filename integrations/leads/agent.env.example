# Copy to .env.agent on the SOURCE server; never commit filled values.
# For Docker Compose interpolation export SOURCE_DIRECTORY or pass --env-file .env.agent.
SOURCE_DIRECTORY=/absolute/path/to/site/data
LEADS_SOURCE_FILE=/source/site.sqlite
LEADS_SOURCE_FORMAT=accessibility-sqlite
LEADS_SITE_HOST=pasport-dostupnosty.ru
LEADS_ENDPOINT=https://boykov-services.ru/hooks/leads/accessibility
LEADS_TOKEN=replace-with-the-one-time-key-from-the-leads-page
