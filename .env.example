NODE_ENV=development
PORT=8787
HOST=127.0.0.1
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787
# npm run setup creates a scrypt hash and internal token. No default password.
AUTH_PASSWORD_HASH=
WORKER_TOKEN=
WORKER_URL=http://127.0.0.1:8790
COOKIE_SECURE=false
TRUST_PROXY=false
DATA_DIR=./data
TZ=Europe/Moscow

# Техотдел: приём данных из Apps Script. Google Cloud Billing не требуется.
# Секрет должен совпадать с BOYKOV_TECH_PUSH_TOKEN в свойствах Apps Script.
TECH_PUSH_IMPORT_TOKEN=

# Дзен: создайте отдельный .env.dzen через scripts/configure-dzen.py.
