+            {metrics.map((m) => {
+              const total = totalMetric(selected, m.key),
+                Icon = icons[m.key];
+              return (
+                <button
+                  type="button"
+                  key={m.key}
+                  className={`stats-kpi ${m.tone} ${metric === m.key ? "so-metric-selected" : ""}`}
+                  aria-pressed={metric === m.key}
